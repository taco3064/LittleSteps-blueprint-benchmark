{
  "name": "littlesteps",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:rules": "firebase emulators:exec --only database --project demo-littlesteps \"node scripts/testRules.cjs\"",
    "test:e2e": "playwright test",
    "test:e2e:p0": "playwright test --grep @p0",
    "prepare": "husky install",
    "check": "npm run typecheck && npm run lint && blueprint inspect && blueprint doctor"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "framer-motion": "^10.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "9.39.2",
    "@kekkai/blueprint": "file:vendor/kekkai-blueprint-4.1.0-lf-15993dadd505.tgz",
    "@playwright/test": "1.56.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/leaflet": "1.9.21",
    "@types/react": "18.3.28",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "4.1.2",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "firebase-tools": "15.11.0",
    "globals": "16.5.0",
    "happy-dom": "20.8.9",
    "husky": "^9.1.7",
    "jsdom": "27.0.1",
    "postcss": "8.5.8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.56.1",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "4.1.2"
  },
  "overrides": {
    "vitest": {
      "vite": "6.4.1"
    }
  }
}
