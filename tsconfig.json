{
  "compilerOptions": {
    "paths": {"~app/*": ["./src/*"]},
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    /* npm run lint 與 npm run build 各跑一次 tsc，pre-commit 又跑一次 build。
       增量資訊讓後面幾次只重查改過的部分，不然三次全查是十幾秒起跳。 */
    "incremental": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["test-support", "src", "e2e", "playwright.config.ts"]
}
